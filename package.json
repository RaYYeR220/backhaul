{
  "name": "backhaul",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test:contracts": "cd contracts && forge test",
    "test": "npm run test --workspaces --if-present",
    "deploy": "tsx packages/sdk/scripts/deploy.ts",
    "deploy:dry": "tsx packages/sdk/scripts/deploy.ts --dry-run",
    "relayer": "npm start -w services/relayer --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:ink": "tsx packages/sdk/scripts/build-ink.ts",
    "test:ink": "cd ink/parlia_client && cargo test --release",
    "bench:evm": "cd contracts && forge test --match-contract ParliaBenchmarkTest",
    "bench:wasm": "cd ink/bench && cargo run --release",
    "benchmark": "tsx packages/sdk/scripts/benchmark.ts && tsx packages/sdk/scripts/render-benchmark.ts",
    "test:counts": "tsx packages/sdk/scripts/test-counts.ts",
    "rehearse:beefy": "tsx packages/sdk/scripts/rehearse-beefy.ts",
    "rehearse:parlia": "tsx packages/sdk/scripts/rehearse-parlia.ts",
    "rehearse": "npm run rehearse:beefy && npm run rehearse:parlia",
    "verify:onchain": "tsx packages/sdk/scripts/verify-onchain.ts",
    "record:live": "tsx packages/sdk/scripts/record-live.ts",
    "findings": "tsx packages/sdk/scripts/check-findings.ts",
    "docs": "tsx packages/sdk/scripts/render-docs.ts"
  },
  "engines": {
    "node": ">=22"
  }
}
