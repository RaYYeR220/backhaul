# Copy to .env (git-ignored) or pass any file with --env <path>. Names only here, never values.

# EVM key that deploys on both chains and signs relayer transactions (0x-prefixed hex)
PORTALDOT_DEPLOYER_PK=
# Its address, for keyless dry runs
PORTALDOT_DEPLOYER_EVM=
# sr25519 mnemonic for pallet-assets calls (creating BNB.b) and substrate transfers
PORTALDOT_OPS_MNEMONIC=
PORTALDOT_OPS_SS58=

# Optional RPC overrides
PORTALDOT_EVM_RPC=
PORTALDOT_WS=
BSC_RPC=

# Optional: pallet-assets id for BNB.b (default 9797)
BNBB_ASSET_ID=
# Optional: BscScan / Etherscan v2 key for contract verification
ETHERSCAN_API_KEY=

# Relayer
# Key for relayer transactions (defaults to PORTALDOT_DEPLOYER_PK)
RELAYER_PK=
# Key of the solver's own inventory (fast fills); empty disables the solver
SOLVER_PK=
# Key of the demo signer behind POST /demo/transfer; empty disables it
DEMO_PK=
# HTTP port of the relayer API
RELAYER_PORT=
# Data directory (justification archive, block-hash cache, job store)
BACKHAUL_DATA=
# 1 (default): Parlia windows pass over untrusted seals, as ParliaClient does
BACKHAUL_PARLIA_TOLERANT=
